#!/bin/sh
# Build dist/KoboRoot.tgz: the standard Kobo add-on package. Dropped into
# .kobo/ on the USB drive, the Kobo extracts it over / at the next boot
# (see /etc/init.d/rcS), so paths under mnt/onboard/.adds land on the user
# partition. The NickelMenu lines go in their own file in .adds/nm/, which
# NickelMenu reads alongside the user's config.
set -eu
cd "$(dirname "$0")/.."
BIN=target/armv7-unknown-linux-musleabihf/release/annas-kobo
[ -f "$BIN" ] || tools/build
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/mnt/onboard/.adds/annas-kobo" "$STAGE/mnt/onboard/.adds/nm"
cp "$BIN" "$STAGE/mnt/onboard/.adds/annas-kobo/annas-kobo"
cp kobo/annas-kobo.sh "$STAGE/mnt/onboard/.adds/annas-kobo/annas-kobo.sh"
cp kobo/nm-annas-kobo "$STAGE/mnt/onboard/.adds/nm/annas-kobo"
chmod 755 "$STAGE/mnt/onboard/.adds/annas-kobo/"*
mkdir -p dist
# root-owned, no macOS metadata, gzip: what rcS expects
COPYFILE_DISABLE=1 tar -c -z -f dist/KoboRoot.tgz --uid 0 --gid 0 --numeric-owner -C "$STAGE" mnt
cp "$BIN" dist/annas-kobo
ls -la dist/
tar -tzf dist/KoboRoot.tgz
