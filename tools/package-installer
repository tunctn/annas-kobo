#!/bin/sh
# Build dist/AnnasKoboInstaller.zip: a Mac app that wraps tools/install-usb.
# Double-clicking it finds the Kobo over USB, installs NickelMenu if needed,
# installs or updates Anna's Kobo, and ejects. It has no Apple signature, so
# the first launch needs right-click, Open.
set -eu
cd "$(dirname "$0")/.."
VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml)"
APP="dist/Anna's Kobo Installer.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
sed "s/@VERSION@/$VERSION/g" mac/Info.plist > "$APP/Contents/Info.plist"
cp tools/install-usb "$APP/Contents/Resources/install-usb"
cat > "$APP/Contents/MacOS/installer" <<'SH'
#!/bin/sh
GUI=1 exec "$(dirname "$0")/../Resources/install-usb"
SH
chmod 755 "$APP/Contents/MacOS/installer" "$APP/Contents/Resources/install-usb"
rm -f dist/AnnasKoboInstaller.zip
(cd dist && zip -qr AnnasKoboInstaller.zip "Anna's Kobo Installer.app")
ls -la dist/AnnasKoboInstaller.zip
